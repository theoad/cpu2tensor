+static bool plugin_u64_condition(enum qemu_plugin_cond cond,
+                                 uint64_t value, uint64_t imm)
+{
+    switch (cond) {
+    case QEMU_PLUGIN_COND_EQ:
+        return value == imm;
+    case QEMU_PLUGIN_COND_NE:
+        return value != imm;
+    case QEMU_PLUGIN_COND_LT:
+        return value < imm;
+    case QEMU_PLUGIN_COND_LE:
+        return value <= imm;
+    case QEMU_PLUGIN_COND_GT:
+        return value > imm;
+    case QEMU_PLUGIN_COND_GE:
+        return value >= imm;
+    case QEMU_PLUGIN_COND_ALWAYS:
+        return true;
+    case QEMU_PLUGIN_COND_NEVER:
+        return false;
+    default:
+        g_assert_not_reached();
+    }
+}
