+static bool plugin_tb_has_mem_cond(struct qemu_plugin_tb *tb)
+{
+    for (size_t i = 0; i < tb->n; i++) {
+        struct qemu_plugin_insn *insn = g_ptr_array_index(tb->insns, i);
+        GArray *cbs = insn->mem_cbs;
+
+        for (size_t j = 0, n = cbs ? cbs->len : 0; j < n; j++) {
+            struct qemu_plugin_dyn_cb *cb =
+                &g_array_index(cbs, struct qemu_plugin_dyn_cb, j);
+            if (cb->type == PLUGIN_CB_MEM_COND) {
+                return true;
+            }
+        }
+    }
+    return false;
+}
+
+static void preserve_mem_cond_temps(struct qemu_plugin_tb *tb)
+{
+    if (!plugin_tb_has_mem_cond(tb)) {
+        return;
+    }
+
+    /*
+     * A conditional memory callback introduces a branch after translation.
+     * Let the normal liveness pass decide which translated temporaries now
+     * cross that new EBB boundary instead of assuming none of them do.
+     */
+    for (int i = tcg_ctx->nb_globals; i < tcg_ctx->nb_temps; i++) {
+        if (tcg_ctx->temps[i].kind == TEMP_EBB) {
+            tcg_ctx->temps[i].kind = TEMP_TB;
+        }
+    }
+}
