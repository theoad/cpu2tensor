 #define gpr_map gpr_map32
 #endif
 static const int gpr_map32[8] = { 0, 1, 2, 3, 4, 5, 6, 7 };
+
+#if defined(CONFIG_PLUGIN) && defined(TARGET_X86_64) && !defined(CONFIG_USER_ONLY)
+/*
+ * Optional cpu2tensor v1 state hook. The caller must request R_REGS so TCG
+ * synchronizes architectural state before this callback. This copies raw
+ * storage; the execution width describes how to interpret subregisters.
+ * The same patch fixes the public memory API's MMIO classification.
+ */
+bool qemu_plugin_cpu2tensor_x86_state_v1(uint64_t *out, size_t count)
+{
+    CPUX86State *env;
+    X86CPU *cpu;
+    size_t i;
+
+    if (!out || (count != 8 && count != 28) || !current_cpu ||
+        qemu_plugin_get_cb_flags() == QEMU_PLUGIN_CB_NO_REGS) {
+        return false;
+    }
+    cpu = X86_CPU(current_cpu);
+    env = &cpu->env;
+    out[0] = env->cr[0];
+    out[1] = env->cr[2];
+    out[2] = env->cr[3];
+    out[3] = env->cr[4];
+    out[4] = 0; /* Reserved, not a CR8 sample: no implicit VAPIC access. */
+    out[5] = env->efer;
+    out[6] = env->segs[R_CS].base;
+    out[7] = (env->hflags & HF_CS64_MASK) ? 64 :
+             (env->hflags & HF_CS32_MASK) ? 32 : 16;
+    if (count == 28) {
+        for (i = 0; i < 16; i++) {
+            out[8 + i] = env->regs[gpr_map[i]];
+        }
+        out[24] = env->eip;
+        out[25] = env->segs[R_FS].base;
+        out[26] = env->segs[R_GS].base;
+        out[27] = env->kernelgsbase;
+    }
+    return true;
+}
+#endif
+
 
